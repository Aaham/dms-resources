# =============================================================================
# DMS resources: server environment
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored; never commit it.
#
#   cp .env.example .env
#
# The server starts with values missing and prints what is not configured.
# `GET /api/health` reports the same list.
# =============================================================================


# --- 1. Where the site lives -------------------------------------------------
# The public origin. Used for the links in emails, and the cookie is marked
# Secure when this starts with https://.
PUBLIC_URL=http://localhost:1026

PORT=1026

# Set to 1 behind a proxy or load balancer (Railway, Render, Fly, nginx).
# Without it every visitor appears to come from one IP address and the rate
# limit applies to all of them together.
TRUST_PROXY=0

# Visitor email addresses and submitted scorecards are stored here. In
# production, point this at a persistent volume.
DATA_DIR=./data


# --- 2. Access ---------------------------------------------------------------
# Signs the cookie that remembers a visitor's email address, and the links in
# emails. At least 32 characters; the resources do not open without it.
# Changing it makes every browser ask for an email address again and breaks
# links already sent. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a browser stays open after an email address is entered, and how
# long the link in a report email works.
REMEMBER_DAYS=90

# Email addresses that may be entered from one IP address every 15 minutes,
# and the number of links emails one IP address can cause in a day. People in
# one room on the same Wi-Fi share an address, so this is higher than a
# typical form limit. Raise it before a large event.
ACCESS_REQUESTS_PER_IP=60


# --- 3. Email (Brevo SMTP) ---------------------------------------------------
# The same Brevo account the webinar and training projects use. Copy the values
# from dms-webinar/server/.env.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DMS <noreply@send.strategydms.com>

# Set to 1 to print each email's recipient and subject to the console instead
# of sending it.
SMTP_DEV_LOG=

# Most emails this site may send in any 24 hours. Each visitor uses one email
# for the links and one for a scorecard report. The Brevo account is shared
# with other DMS projects, so keep this below the plan's daily limit.
# 0 turns the cap off.
MAIL_DAILY_LIMIT=250

# Most links emails in any 24 hours. Entering an address is all it takes to
# cause one, so they get a smaller share and a flood of entries cannot use up
# what the scorecard reports need. 0 turns this cap off.
LINKS_DAILY_LIMIT=150

# Comma-separated addresses that the per-address limits do not apply to (one
# links email and one report a day, five of each ever). For testing. Anyone
# who enters a listed address can have it emailed without those limits.
UNLIMITED_EMAILS=


# --- 4. Staff view at /ops ---------------------------------------------------
# Comma-separated addresses that may open /ops. Each opens it from a link the
# site emails to that address. Leave empty to switch /ops off.
OPS_EMAILS=

# How long an emailed staff link can be opened, and how long /ops then stays
# open in that browser.
OPS_LINK_MINUTES=15
OPS_SESSION_HOURS=12
